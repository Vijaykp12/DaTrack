# PostgreSQL Connection String
# Works seamlessly with Neon, Supabase, Render, Railway, or standard PostgreSQL.
#
# Examples:
# Neon (Serverless Postgres):
# DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase (Connection Pooling):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
#
# Render / Railway:
# DATABASE_URL="postgresql://postgres:password@postgres.render.com:5432/datrack_db"
#
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/datrack"

DATABASE_URL="postgresql://postgres:password@localhost:5432/datrack"
